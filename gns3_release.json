{
  "builders": [
    {
      "headless": true,
      "shutdown_command": "echo {{user `ssh_name`}} | sudo -S shutdown -P now",
      "shutdown_timeout": "60m",
      "skip_compaction": false,
      "source_path": "{{user `gns3_src`}}",
      "ssh_password": "{{user `ssh_pass`}}",
      "ssh_username": "{{user `ssh_name`}}",
      "type": "vmware-vmx",
      "vm_name": "GNS3 VM",
      "vmx_data_post": {
        "disk.enableUUID": "TRUE",
        "ethernet0.addressType": "generated",
        "ethernet0.connectionType": "hostonly",
        "ethernet0.generatedAddressOffset": "0",
        "ethernet0.pciSlotNumber": "32",
        "ethernet0.present": "TRUE",
        "ethernet0.startConnected": "TRUE",
        "ethernet0.wakeOnPcktRcv": "FALSE",
        "ethernet1.addressType": "generated",
        "ethernet1.connectionType": "nat",
        "ethernet1.generatedAddressOffset": "10",
        "ethernet1.pciSlotNumber": "33",
        "ethernet1.present": "TRUE",
        "ethernet1.startConnected": "TRUE",
        "ethernet1.virtualDev": "e1000",
        "ethernet1.wakeOnPcktRcv": "FALSE",
        "vhv.enable": "TRUE"
      }
    },
    {
      "format": "ova",
      "guest_additions_mode": "disable",
      "headless": false,
      "shutdown_command": "echo {{user `ssh_name`}} | sudo -S shutdown -P now",
      "shutdown_timeout": "60m",
      "source_path": "{{user `gns3_src`}}",
      "ssh_handshake_attempts": "20",
      "ssh_password": "{{user `ssh_pass`}}",
      "ssh_timeout": "20m",
      "ssh_username": "{{user `ssh_name`}}",
      "type": "virtualbox-ovf",
      "vboxmanage": [
        [
          "modifyvm",
          "{{.Name}}",
          "--nic1",
          "nat"
        ]
      ],
      "vboxmanage_post": [
        [
          "modifyvm",
          "{{.Name}}",
          "--nic1",
          "hostonly"
        ],
        [
          "modifyvm",
          "{{.Name}}",
          "--nictype1",
          "82540EM"
        ],
        [
          "modifyvm",
          "{{.Name}}",
          "--hostonlyadapter1",
          "vboxnet0"
        ],
        [
          "modifyvm",
          "{{.Name}}",
          "--nic2",
          "nat"
        ],
        [
          "modifyvm",
          "{{.Name}}",
          "--nictype2",
          "82540EM"
        ],
        [
          "modifyvm",
          "{{.Name}}",
          "--graphicscontroller",
          "vmsvga"
        ],
        [
          "modifyvm",
          "{{.Name}}",
          "--vram",
          "16"
        ],
        [
          "modifyvm",
          "{{.Name}}",
          "--nested-hw-virt",
          "on"
        ]
      ],
      "vm_name": "GNS3 VM"
    },
    {
      "disk_compression": true,
      "disk_image": true,
      "headless": true,
      "http_directory": "http",
      "iso_checksum": "{{user `iso_checksum_type`}}:{{user `iso_checksum`}}",
      "iso_url": "{{user `iso_url`}}",
      "net_device": "virtio-net-pci",
      "qemu_binary": "qemu-system-aarch64",
      "qemuargs": [
        [
          "-drive",
          "file=gns3vm-disk1.qcow2,if=virtio,format=qcow2,cache=none"
        ],
        [
          "-drive",
          "file=gns3vm-disk2.qcow2,if=virtio,format=qcow2,cache=none"
        ],
        [
          "-serial",
          "file:serial.out"
        ],
        [
          "-machine",
          "virt,gic-version=3,accel=kvm"
        ],
        [
          "-cpu",
          "max"
        ],
        [
          "-smp",
          "4"
        ],
        [
          "-m",
          "2048"
        ],
        [
          "-bios",
          "/usr/share/qemu-efi-aarch64/QEMU_EFI.fd"
        ],
        [
          "-boot",
          "strict=off"
        ]
      ],
      "shutdown_command": "echo {{user `ssh_name`}} | sudo -S shutdown -P now",
      "shutdown_timeout": "20m",
      "ssh_handshake_attempts": "20",
      "ssh_password": "{{user `ssh_pass`}}",
      "ssh_timeout": "20m",
      "ssh_username": "{{user `ssh_name`}}",
      "type": "qemu",
      "use_default_display": true,
      "vm_name": "GNS3 VM"
    }
  ],
  "provisioners": [
    {
      "inline": "sudo rm -rf /tmp/*",
      "type": "shell"
    },
    {
      "inline": "echo -n \"{{user `gns3_release_channel`}}\" > /home/gns3/.config/GNS3/gns3_release_channel",
      "type": "shell"
    },
    {
      "destination": "/tmp/gns3welcome.py",
      "source": "scripts/welcome.py",
      "type": "file"
    },
    {
      "environment_vars": [
        "GNS3_VERSION={{user `gns3_version`}}"
      ],
      "script": "scripts/provision_gns3.sh",
      "type": "shell"
    }
  ],
  "variables": {
    "gns3_release_channel": "{{env `GNS3_RELEASE_CHANNEL`}}",
    "gns3_src": "{{env `GNS3_SRC`}}",
    "gns3_version": "{{env `GNS3_VERSION`}}",
    "iso_checksum": "b8f31413336b9393ad5d8ef0282717b2ab19f007df2e9ed5196c13d8f9153c8b",
    "iso_checksum_type": "sha256",
    "iso_url": "https://releases.ubuntu.com/20.04/ubuntu-20.04.6-live-server-amd64.iso",
    "ssh_name": "gns3",
    "ssh_pass": "gns3"
  }
}
